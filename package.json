{
  "name": "holychords-offline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Офлайн-приложение с базой христианских песен и транспонированием аккордов (личное использование)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "crawl": "tsx scripts/crawl.ts",
    "db:build": "tsx scripts/build-db.ts",
    "db:install": "node scripts/install-db.mjs",
    "delta:build": "tsx scripts/build-delta.ts",
    "release:publish": "tsx scripts/publish-release.ts",
    "verify:transpose": "tsx scripts/verify-transpose.ts",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:apk:full": "npm run db:build && npm run db:install && npm run android:apk",
    "android:apk:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "cheerio": "^1.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
